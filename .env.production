VITE_BASE_URL=https://remsfal.online
VITE_SERVICE_WORKER_ENABLED=true
VITE_OTEL_ENABLED=true
VITE_OTEL_SERVICE_NAME=remsfal-frontend
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT is intentionally unset here — ops must supply the
# reachable OTLP/HTTP base URL for this environment at deploy time. Production routing to
# the collector is external to this repo (see docker/nginx, which has no /api or /ticketing
# proxy either); initTelemetry() no-ops with a console.warn if this stays unset.
